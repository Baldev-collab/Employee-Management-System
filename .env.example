

# ===================================================================
# Employee Management System - Environment Variables Example
# Copy this file to '.env' and fill in your actual local configuration.
# DO NOT commit '.env' to version control!
# ===================================================================

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/employee_management?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password_here

# Server Port
SERVER_PORT=8080
